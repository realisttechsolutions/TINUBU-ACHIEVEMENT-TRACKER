{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tinubuachievements.gov.ng/schemas/research/achievement_record.schema.json",
  "title": "Achievement Record Research Schema",
  "description": "Validation schema for research data collected for the Tinubu Achievement Tracker V2",
  "type": "object",
  "required": [
    "id",
    "slug",
    "title",
    "achievementType",
    "sector",
    "summary",
    "fullDescription",
    "impactOutcome",
    "beneficiariesOrScope",
    "status",
    "classification",
    "publicationStatus",
    "leadMinistryOrAgency",
    "verificationDate",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique string or UUID identifier for the record",
      "minLength": 3
    },
    "slug": {
      "type": "string",
      "description": "URL-safe unique slug identifier (e.g. lagos-calabar-coastal-highway)",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "description": "Full descriptive title of the achievement",
      "minLength": 5,
      "maxLength": 250
    },
    "shortTitle": {
      "type": "string",
      "description": "Concise title for breadcrumbs and cards",
      "maxLength": 80
    },
    "achievementType": {
      "type": "string",
      "enum": [
        "physical-project",
        "policy-reform",
        "programme-intervention",
        "institutional-improvement",
        "reported-outcome"
      ]
    },
    "sector": {
      "type": "string",
      "enum": [
        "economy",
        "security",
        "infrastructure",
        "social-services",
        "governance"
      ]
    },
    "summary": {
      "type": "string",
      "description": "1-2 sentence concise executive summary",
      "minLength": 10,
      "maxLength": 400
    },
    "fullDescription": {
      "type": "string",
      "description": "In-depth narrative of the achievement background and execution",
      "minLength": 20
    },
    "impactOutcome": {
      "type": "string",
      "description": "Reported quantitative or qualitative impact result",
      "minLength": 5
    },
    "beneficiariesOrScope": {
      "type": "string",
      "description": "Geographic or demographic coverage details"
    },
    "status": {
      "type": "string",
      "enum": [
        "Operational",
        "Completed",
        "Implementation Ongoing",
        "Outcome Recorded",
        "Approved",
        "Planning Phase",
        "Under Review"
      ]
    },
    "classification": {
      "type": "string",
      "enum": [
        "Actual",
        "Provisional",
        "Projected",
        "Target"
      ]
    },
    "publicationStatus": {
      "type": "string",
      "enum": [
        "draft",
        "under-review",
        "publishable",
        "publishable-with-qualification",
        "rejected",
        "archived"
      ]
    },
    "leadMinistryOrAgency": {
      "type": "string",
      "description": "Primary responsible Ministry, Department, or Agency"
    },
    "geopoliticalZone": {
      "type": "string"
    },
    "statesCovered": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "startDate": {
      "type": "string"
    },
    "completionOrCurrentDate": {
      "type": "string"
    },
    "verificationDate": {
      "type": "string",
      "description": "Date of evidence verification audit (YYYY-MM-DD or Month YYYY)"
    },
    "featuredImage": {
      "type": "string",
      "format": "uri"
    },
    "relatedAchievementSlugs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "level", "publicationDate"],
        "properties": {
          "name": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "level": { "type": "integer", "minimum": 1, "maximum": 5 },
          "publicationDate": { "type": "string" },
          "documentTitle": { "type": "string" }
        }
      }
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "title", "status", "description"],
        "properties": {
          "date": { "type": "string" },
          "title": { "type": "string" },
          "status": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "keyMetrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "value"],
        "properties": {
          "label": { "type": "string" },
          "value": { "type": "string" },
          "unit": { "type": "string" }
        }
      }
    },
    "internalNotes": {
      "type": "string",
      "description": "Internal researcher auditing notes - NOT for public display"
    },
    "researcherId": {
      "type": "string",
      "description": "Internal researcher identifier - NOT for public display"
    },
    "evidenceRawUrl": {
      "type": "string",
      "format": "uri",
      "description": "Internal link to raw document scan - NOT for public display"
    }
  },
  "additionalProperties": false
}
