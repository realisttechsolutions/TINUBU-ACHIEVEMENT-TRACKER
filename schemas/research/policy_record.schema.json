{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tinubuachievements.gov.ng/schemas/research/policy_record.schema.json",
  "title": "Policy Record Research Schema",
  "description": "Validation schema for policy & legal reform research records in Tinubu Achievement Tracker V2",
  "type": "object",
  "required": [
    "id",
    "slug",
    "title",
    "policyType",
    "status",
    "publicationStatus",
    "legalAuthority",
    "sectorSlug",
    "leadAgency",
    "summary",
    "fullDescription",
    "effectiveDate",
    "primarySources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 3
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 250
    },
    "shortTitle": {
      "type": "string",
      "maxLength": 80
    },
    "policyType": {
      "type": "string",
      "enum": [
        "executive-action",
        "legislation",
        "regulation",
        "fiscal-reform",
        "monetary-financial-reform",
        "trade-investment-reform",
        "administrative-reform",
        "social-policy",
        "security-policy",
        "infrastructure-policy",
        "national-strategy",
        "programme-framework",
        "other"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "announced",
        "approved",
        "enacted",
        "effective",
        "implementation-planning",
        "implementation-ongoing",
        "partially-implemented",
        "fully-implemented",
        "outcome-reported",
        "independently-assessed",
        "suspended",
        "superseded",
        "repealed",
        "under-review",
        "archived"
      ]
    },
    "publicationStatus": {
      "type": "string",
      "enum": [
        "draft",
        "under-review",
        "publishable",
        "publishable-with-qualification",
        "rejected",
        "archived"
      ]
    },
    "legalAuthority": {
      "type": "string",
      "enum": [
        "constitution",
        "act",
        "amendment-act",
        "executive-order",
        "regulation",
        "gazette",
        "budget",
        "federal-executive-council",
        "presidential-directive",
        "ministerial-directive",
        "agency-framework",
        "other"
      ]
    },
    "authorityReference": {
      "type": "string",
      "description": "Official Gazette reference or Act title"
    },
    "sectorSlug": {
      "type": "string",
      "enum": [
        "economy",
        "security",
        "infrastructure",
        "social-services",
        "governance"
      ]
    },
    "leadAgency": {
      "type": "string"
    },
    "responsibleInstitutions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "summary": {
      "type": "string",
      "maxLength": 400
    },
    "fullDescription": {
      "type": "string"
    },
    "backgroundContext": {
      "type": "string"
    },
    "keyObjectives": {
      "type": "array",
      "items": { "type": "string" }
    },
    "effectiveDate": {
      "type": "string"
    },
    "announcementDate": {
      "type": "string"
    },
    "approvalDate": {
      "type": "string"
    },
    "statesCovered": {
      "type": "array",
      "items": { "type": "string" }
    },
    "geopoliticalScope": {
      "type": "string"
    },
    "reportedOutcomes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "primarySources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "url"],
        "properties": {
          "name": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "publishedDate": { "type": "string" },
          "documentType": { "type": "string" }
        }
      }
    },
    "internalNotes": {
      "type": "string"
    },
    "researcherId": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
