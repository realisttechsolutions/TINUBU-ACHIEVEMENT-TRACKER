{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Financial Record Research Template Schema v1.1.1",
  "type": "object",
  "required": [
    "id",
    "record_id",
    "claim_id",
    "financial_type",
    "amount",
    "currency",
    "reporting_period",
    "aggregation_basis"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^\\[[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*\\]$" },
    "record_id": { "type": "string", "pattern": "^\\[[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*\\]$" },
    "claim_id": { "type": "string", "pattern": "^\\[[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*\\]$" },
    "financial_type": {
      "type": "string",
      "enum": [
        "budget_allocation", "approved_funding", "funding_released", "reported_expenditure",
        "contract_value", "programme_envelope", "public_investment", "private_investment",
        "revenue_generated", "revenue_estimate", "savings_estimate"
      ]
    },
    "amount": { "type": "string", "pattern": "^\\d+(?:\\.\\d{1,4})?$" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "reporting_period": { "type": "string" },
    "period_start": { "type": "string" },
    "period_end": { "type": "string" },
    "date_precision": {
      "type": "string",
      "enum": ["exact_day", "month", "quarter", "year", "fiscal_year", "range", "unknown"]
    },
    "aggregation_basis": {
      "type": "string",
      "enum": ["period", "cumulative"]
    },
    "nominal_or_real": {
      "type": "string",
      "enum": ["nominal", "real"]
    },
    "source_institution": { "type": "string" },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
