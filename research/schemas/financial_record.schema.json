{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tinubuachievements.gov.ng/research/schemas/financial_record.schema.json",
  "title": "Financial Record Schema v1.1",
  "description": "Validation schema separating statutory allocation, approval, released funding, actual expenditure, contract values, private capital, and revenues.",
  "type": "object",
  "required": [
    "id",
    "record_id",
    "claim_id",
    "financial_type",
    "amount",
    "currency",
    "reporting_period",
    "aggregation_basis"
  ],
  "properties": {
    "id": { "type": "string" },
    "record_id": { "type": "string" },
    "claim_id": { "type": "string" },
    "financial_type": {
      "type": "string",
      "enum": [
        "budget_allocation",
        "approved_funding",
        "funding_released",
        "reported_expenditure",
        "contract_value",
        "programme_envelope",
        "public_investment",
        "private_investment",
        "revenue_generated",
        "revenue_estimate",
        "savings_estimate"
      ]
    },
    "amount": { "type": ["number", "string"] },
    "currency": { "type": "string", "default": "NGN" },
    "reporting_period": { "type": "string" },
    "date_value": { "type": "string" },
    "date_precision": {
      "type": "string",
      "enum": ["exact_day", "month", "quarter", "year", "fiscal_year", "range", "unknown"]
    },
    "period_start": { "type": "string" },
    "period_end": { "type": "string" },
    "geographic_scope": { "type": "string" },
    "geographic_unit_id": { "type": "string" },
    "aggregation_basis": {
      "type": "string",
      "enum": ["period", "cumulative"]
    },
    "nominal_or_real": {
      "type": "string",
      "enum": ["nominal", "real"]
    },
    "methodology": { "type": "string" },
    "limitation": { "type": "string" },
    "source_url": { "type": "string" },
    "internal_notes": { "type": "string" },
    "example_marker": { "type": "string" }
  },
  "additionalProperties": false
}
