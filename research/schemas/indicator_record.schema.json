{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tinubuachievements.gov.ng/research/schemas/indicator_record.schema.json",
  "title": "Indicator Definition Schema v1.1",
  "description": "Validation schema for performance metric and indicator definitions in Tinubu Achievement Tracker v1.1.",
  "type": "object",
  "required": [
    "indicator_id",
    "slug",
    "name",
    "sector_slug",
    "unit",
    "source_agency",
    "data_classification"
  ],
  "properties": {
    "indicator_id": { "type": "string", "minLength": 3 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 3 },
    "sector_slug": {
      "type": "string",
      "enum": [
        "economy",
        "security",
        "infrastructure",
        "social_services",
        "social-services",
        "governance",
        "economy_fiscal_reforms",
        "security_national_stability",
        "infrastructure_transportation",
        "agriculture_food_security",
        "education_human_capital",
        "healthcare_public_health",
        "social_protection_human_development",
        "youth_employment_skills",
        "power_energy_natural_resources",
        "digital_economy_science_innovation",
        "housing_urban_development",
        "environment_climate",
        "governance_public_service",
        "foreign_affairs_international_cooperation",
        "culture_tourism_creative_economy"
      ]
    },
    "subsector": { "type": "string" },
    "unit": { "type": "string" },
    "baseline_value": { "type": "string" },
    "baseline_date": { "type": "string" },
    "target_value": { "type": "string" },
    "target_date": { "type": "string" },
    "calculation_methodology": { "type": "string" },
    "source_agency": { "type": "string" },
    "data_classification": {
      "type": "string",
      "enum": [
        "actual",
        "provisional",
        "estimated",
        "projected",
        "target",
        "government_target",
        "calculated",
        "modelled",
        "government_reported",
        "independently_reported",
        "under_review",
        "corrected",
        "withdrawn"
      ]
    },
    "internal_notes": { "type": "string" }
  },
  "additionalProperties": false
}
