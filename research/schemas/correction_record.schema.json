{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tinubuachievements.gov.ng/research/schemas/correction_record.schema.json",
  "title": "Correction Record Schema v1.1",
  "description": "Validation schema for historical revisions, claim corrections, and figure adjustment audit logs.",
  "type": "object",
  "required": [
    "correction_id",
    "record_id",
    "field_name",
    "previous_value",
    "new_value",
    "correction_reason",
    "revised_by",
    "correction_date"
  ],
  "properties": {
    "correction_id": { "type": "string" },
    "record_id": { "type": "string" },
    "claim_id": { "type": "string" },
    "correction_type": {
      "type": "string",
      "enum": ["fact_update", "figure_revision", "status_change", "source_addition", "scope_correction", "redaction", "retraction"]
    },
    "field_name": { "type": "string" },
    "previous_value": { "type": "string" },
    "new_value": { "type": "string" },
    "correction_reason": { "type": "string" },
    "source_url": { "type": "string" },
    "revised_by": { "type": "string" },
    "correction_date": { "type": "string" },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
