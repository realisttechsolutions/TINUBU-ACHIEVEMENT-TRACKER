{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tinubuachievements.gov.ng/research/schemas/entity_discovery.schema.json",
  "title": "Entity Discovery Research Schema v1.1",
  "description": "Validation schema for initial entity discovery leads prior to structured claim extraction.",
  "type": "object",
  "required": [
    "candidate_record_type",
    "candidate_title",
    "sector",
    "institution",
    "discovery_source"
  ],
  "properties": {
    "candidate_record_type": {
      "type": "string",
      "enum": [
        "achievement",
        "policy",
        "reform",
        "executive_action",
        "legislation",
        "regulation",
        "programme",
        "intervention",
        "physical_project",
        "institutional_reform",
        "reported_outcome",
        "timeline_event",
        "milestone",
        "indicator",
        "indicator_observation",
        "source",
        "correction_revision",
        "report",
        "dataset",
        "methodology",
        "physical-project",
        "policy-reform",
        "programme-intervention",
        "institutional-improvement",
        "reported-outcome"
      ]
    },
    "candidate_title": { "type": "string", "minLength": 3 },
    "aliases": { "type": "string" },
    "sector": {
      "type": "string",
      "enum": [
        "economy",
        "security",
        "infrastructure",
        "social_services",
        "social-services",
        "governance",
        "economy_fiscal_reforms",
        "security_national_stability",
        "infrastructure_transportation",
        "agriculture_food_security",
        "education_human_capital",
        "healthcare_public_health",
        "social_protection_human_development",
        "youth_employment_skills",
        "power_energy_natural_resources",
        "digital_economy_science_innovation",
        "housing_urban_development",
        "environment_climate",
        "governance_public_service",
        "foreign_affairs_international_cooperation",
        "culture_tourism_creative_economy"
      ]
    },
    "subsector": { "type": "string" },
    "institution": { "type": "string" },
    "geography": { "type": "string" },
    "possible_existing_record": { "type": "string" },
    "discovery_source": { "type": "string" },
    "initial_notes": { "type": "string" }
  },
  "additionalProperties": false
}
