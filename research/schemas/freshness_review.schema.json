{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Freshness Review Research Template Schema v1.1.1",
  "type": "object",
  "required": [
    "review_id",
    "record_id",
    "last_verified_date",
    "stale_threshold_days",
    "freshness_status",
    "next_review_due",
    "assigned_reviewer"
  ],
  "properties": {
    "review_id": { "type": "string", "pattern": "^\\[[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*\\]$" },
    "record_id": { "type": "string", "pattern": "^\\[[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*\\]$" },
    "last_verified_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "stale_threshold_days": { "type": "string" },
    "freshness_status": {
      "type": "string",
      "enum": ["fresh", "due_for_review", "stale", "review_in_progress", "historical_closed"]
    },
    "next_review_due": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "assigned_reviewer": { "type": "string", "minLength": 2 },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
