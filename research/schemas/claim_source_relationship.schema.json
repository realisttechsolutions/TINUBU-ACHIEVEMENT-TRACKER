{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tinubuachievements.gov.ng/research/schemas/claim_source_relationship.schema.json",
  "title": "Claim-Source Relationship Schema v1.1",
  "description": "Validation schema for many-to-many claim-to-source relationships, establishing specific evidentiary roles, locators, and review statuses.",
  "type": "object",
  "required": [
    "schema_version",
    "research_batch_id",
    "relationship_id",
    "claim_id",
    "source_id",
    "source_role",
    "relationship_type",
    "evidence_location",
    "evidence_summary",
    "review_status",
    "created_at",
    "created_by"
  ],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.1"] },
    "research_batch_id": { "type": "string" },
    "relationship_id": { "type": "string" },
    "claim_id": { "type": "string" },
    "source_id": { "type": "string" },
    "source_role": {
      "type": "string",
      "enum": [
        "primary",
        "official_statistical",
        "direct_implementation",
        "independent_assessment",
        "corroborating",
        "supporting",
        "contextual",
        "contradictory",
        "replacement",
        "archived",
        "discovery_lead"
      ]
    },
    "relationship_type": {
      "type": "string",
      "enum": ["supports", "contradicts", "replaces", "contextualises", "discovery_only"]
    },
    "evidence_location": { "type": "string", "minLength": 2 },
    "evidence_summary": { "type": "string", "minLength": 5, "maxLength": 500 },
    "limitation": { "type": "string" },
    "review_status": {
      "type": "string",
      "enum": ["source_confirmed", "cross_referenced", "independently_corroborated", "under_review", "unverified", "disputed", "corrected", "withdrawn"]
    },
    "reviewed_by": { "type": "string" },
    "reviewed_at": { "type": "string" },
    "supersedes_relationship_id": { "type": "string" },
    "created_at": { "type": "string" },
    "created_by": { "type": "string" },
    "validation_result": { "type": "string" },
    "example_marker": { "type": "string" }
  },
  "additionalProperties": false
}
