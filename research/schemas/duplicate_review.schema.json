{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tinubuachievements.gov.ng/research/schemas/duplicate_review.schema.json",
  "title": "Duplicate Review Schema",
  "description": "Validation schema for duplicate detection and alias tracking.",
  "type": "object",
  "required": [
    "duplicate_id",
    "record_id_1",
    "title_1",
    "record_id_2",
    "title_2",
    "match_confidence",
    "resolution_action"
  ],
  "properties": {
    "duplicate_id": { "type": "string" },
    "record_id_1": { "type": "string" },
    "title_1": { "type": "string" },
    "record_id_2": { "type": "string" },
    "title_2": { "type": "string" },
    "match_confidence": { "type": ["number", "string"] },
    "resolution_action": { "type": "string", "enum": ["merge", "separate", "alias_only", "under_review"] },
    "merged_canonical_id": { "type": "string" },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
