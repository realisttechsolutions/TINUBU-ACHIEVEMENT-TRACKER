{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tinubuachievements.gov.ng/research/schemas/beneficiary_record.schema.json",
  "title": "Beneficiary Record Schema v1.1",
  "description": "Validation schema separating registered applicants, screened eligibles, approved beneficiaries, active recipients, and payment disbursements.",
  "type": "object",
  "required": [
    "id",
    "record_id",
    "claim_id",
    "beneficiary_stage",
    "count_value",
    "unit",
    "beneficiary_type",
    "reporting_period",
    "count_basis"
  ],
  "properties": {
    "id": { "type": "string" },
    "record_id": { "type": "string" },
    "claim_id": { "type": "string" },
    "beneficiary_stage": {
      "type": "string",
      "enum": [
        "applicant",
        "registered_participant",
        "eligible_applicant",
        "approved_beneficiary",
        "disbursement_recipient",
        "active_beneficiary"
      ]
    },
    "count_value": { "type": ["number", "string"] },
    "unit": { "type": "string" },
    "beneficiary_type": {
      "type": "string",
      "enum": ["individual", "household", "msme", "student", "farmer", "patient", "enterprise"]
    },
    "reporting_period": { "type": "string" },
    "date_value": { "type": "string" },
    "date_precision": {
      "type": "string",
      "enum": ["exact_day", "month", "quarter", "year", "fiscal_year", "range", "unknown"]
    },
    "period_start": { "type": "string" },
    "period_end": { "type": "string" },
    "geographic_scope": { "type": "string" },
    "geographic_unit_id": { "type": "string" },
    "count_basis": {
      "type": "string",
      "enum": ["period", "cumulative"]
    },
    "cohort_key": { "type": "string" },
    "double_counting_note": { "type": "string" },
    "methodology": { "type": "string" },
    "limitation": { "type": "string" },
    "source_url": { "type": "string" },
    "internal_notes": { "type": "string" },
    "example_marker": { "type": "string" }
  },
  "additionalProperties": false
}
