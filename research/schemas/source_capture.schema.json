{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tinubuachievements.gov.ng/research/schemas/source_capture.schema.json",
  "title": "Source Capture Research Schema",
  "description": "Validation schema for primary legal, statutory, media, and academic source capture records.",
  "type": "object",
  "required": [
    "source_id",
    "source_title",
    "institution",
    "source_type",
    "publication_date",
    "url",
    "source_status"
  ],
  "properties": {
    "source_id": { "type": "string", "minLength": 3 },
    "source_title": { "type": "string", "minLength": 3 },
    "institution": { "type": "string" },
    "source_type": {
      "type": "string",
      "enum": ["gazette", "act", "executive_order", "statutory_report", "bulletin", "international_report", "media_article", "speech", "press_release", "discovery_lead"]
    },
    "publication_date": { "type": "string", "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$" },
    "publication_date_precision": { "type": "string", "enum": ["exact-day", "month", "quarter", "year", "range"] },
    "url": { "type": "string", "format": "uri" },
    "access_date": { "type": "string" },
    "archive_url": { "type": "string" },
    "document_number": { "type": "string" },
    "author": { "type": "string" },
    "publisher": { "type": "string" },
    "language": { "type": "string", "default": "en" },
    "source_status": { "type": "string", "enum": ["active", "archived", "unverified", "deprecated"] },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
