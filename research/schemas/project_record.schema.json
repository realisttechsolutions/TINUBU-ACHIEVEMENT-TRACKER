{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tinubuachievements.gov.ng/research/schemas/project_record.schema.json",
  "title": "Physical Project Record Schema v1.1",
  "description": "Validation schema for capital physical infrastructure projects.",
  "type": "object",
  "required": [
    "id",
    "slug",
    "title",
    "project_type",
    "sector_slug",
    "lead_agency",
    "status",
    "summary"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 3 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 5 },
    "project_type": {
      "type": "string",
      "enum": [
        "road_highway",
        "bridge",
        "rail",
        "aviation_airport",
        "maritime_port",
        "power_generation",
        "transmission_grid",
        "housing_estate",
        "water_dam",
        "hospital_facility",
        "school_campus",
        "digital_infrastructure",
        "physical_project",
        "physical-project",
        "other"
      ]
    },
    "sector_slug": {
      "type": "string",
      "enum": [
        "economy",
        "security",
        "infrastructure",
        "social_services",
        "social-services",
        "governance",
        "economy_fiscal_reforms",
        "security_national_stability",
        "infrastructure_transportation",
        "agriculture_food_security",
        "education_human_capital",
        "healthcare_public_health",
        "social_protection_human_development",
        "youth_employment_skills",
        "power_energy_natural_resources",
        "digital_economy_science_innovation",
        "housing_urban_development",
        "environment_climate",
        "governance_public_service",
        "foreign_affairs_international_cooperation",
        "culture_tourism_creative_economy"
      ]
    },
    "lead_agency": { "type": "string" },
    "location_scope": { "type": "string" },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "announced",
        "approved",
        "enacted",
        "effective",
        "funded",
        "funding_released",
        "procurement",
        "implementation_planning",
        "implementation_ongoing",
        "partially_delivered",
        "completed",
        "operational",
        "outcome_reported",
        "independently_assessed",
        "suspended",
        "superseded",
        "repealed",
        "under_review",
        "archived",
        "withdrawn"
      ]
    },
    "progress_percentage": { "type": ["number", "string"] },
    "budget_or_value": { "type": "string" },
    "states_covered": { "type": "string" },
    "summary": { "type": "string" },
    "full_description": { "type": "string" },
    "source_url": { "type": "string" },
    "internal_notes": { "type": "string" }
  },
  "additionalProperties": false
}
