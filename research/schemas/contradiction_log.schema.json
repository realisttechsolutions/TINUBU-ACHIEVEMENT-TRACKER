{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Contradiction Log Research Template Schema v1.1.1",
  "type": "object",
  "required": [
    "contradiction_id",
    "claim_id_a",
    "claim_id_b",
    "source_id_a",
    "source_id_b",
    "contradiction_summary",
    "severity",
    "resolution_status"
  ],
  "properties": {
    "contradiction_id": { "type": "string", "pattern": "^\\[[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*\\]$" },
    "claim_id_a": { "type": "string", "pattern": "^\\[[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*\\]$" },
    "claim_id_b": { "type": "string", "pattern": "^\\[[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*\\]$" },
    "source_id_a": { "type": "string", "pattern": "^\\[[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*\\]$" },
    "source_id_b": { "type": "string", "pattern": "^\\[[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*\\]$" },
    "contradiction_summary": { "type": "string", "minLength": 10 },
    "severity": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low"]
    },
    "resolution_status": {
      "type": "string",
      "enum": [
        "open", "under_investigation", "resolved_by_primary_evidence",
        "resolved_by_conservative_figure", "unresolved_retained_with_qualification",
        "dismissed_as_erroneous"
      ]
    },
    "resolution_rationale": { "type": "string" },
    "resolved_by": { "type": "string" },
    "resolution_date": { "type": "string" },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
